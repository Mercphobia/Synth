{
  "name": "synth-cli",
  "version": "0.1.0",
  "description": "TypeScript CLI + Ink TUI for Synth — talks to the Python runtime via JSON-RPC over stdio",
  "type": "module",
  "bin": {
    "synth-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://github.com/Mercphobia/Synth"
}
